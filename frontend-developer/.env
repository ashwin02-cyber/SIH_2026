# URL of the FastAPI backend. Used by src/api.js.
# Local development: the backend started with `uvicorn main:app --port 8000`.
# For a deployed site, set VITE_API_URL in Vercel/Netlify (Environment variables) to your
# Render/Railway URL, e.g. https://ipsec-analyzer-api.onrender.com  (see DEPLOY.md).
VITE_API_URL=http://127.0.0.1:8000
