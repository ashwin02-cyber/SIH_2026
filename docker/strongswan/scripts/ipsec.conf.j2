config setup
    charondebug="ike 2, esp 2"

conn {{ conn_name }}
    left={{ left_ip }}
    right={{ right_ip }}
    authby=secret
    ike={{ ike_cipher }}-{{ ike_hash }}-{{ dh_group }}!
    esp={{ esp_proposal }}!
    type={{ mode }}
    keyingtries=1
    ikelifetime=1h
    # Short child-SA lifetime so a rekey (CREATE_CHILD_SA) happens inside a 30 s capture.
    # With PFS on, that rekey performs a fresh Diffie-Hellman exchange.
    keylife=25s
    rekeymargin=5s
    rekeyfuzz=0%
    auto=start
