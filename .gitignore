# environments and caches
venv/
.venv/
*/venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.env
.env.local

# large / bulk data - never commit (kept outside the repo, see DEPLOY.md / README)
*.pcap
*.pcapng
!data/samples/*.pcap
!tests/fixtures/*.pcap
real_captures/*.pcap
*.zip

# build output
frontend-developer/dist/
reports/out/

# frontend env: the committed .env only holds the default local API URL (no secrets)
!frontend-developer/.env
!frontend-developer/.env.example
